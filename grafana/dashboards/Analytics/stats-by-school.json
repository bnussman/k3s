                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  $__timeGroupAlias(created, '1h'),\n  SUM(count(*)) OVER (ORDER BY min(created)) + (SELECT count(*) from \"user\" where created is NULL AND lower(email) LIKE '%${school}')  AS users\nFROM\n  \"user\"\nWHERE\n  created \u003c $__timeTo(created) AND lower(email) LIKE '%${school}'\nGROUP BY created\nORDER BY 1\n\n",
