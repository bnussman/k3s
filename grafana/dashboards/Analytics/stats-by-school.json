                        "rawQuery": true,
                        "rawSql": "SELECT\n  count(*)\nFROM\n  beep\n  LEFT JOIN \"user\" rider on beep.rider_id = \"rider\".id\n  LEFT JOIN \"user\" beeper on beep.beeper_id = \"beeper\".id\nWHERE\n  lower(rider.email) LIKE lower('%${school}')\n  or lower(beeper.email) LIKE lower('%${school}')\nLIMIT\n  1000",
